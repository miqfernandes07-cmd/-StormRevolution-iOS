--- a/XenonUtils/ppc_context.h
+++ b/XenonUtils/ppc_context.h
@@ -211,6 +211,40 @@
 #define PPC_ROUND_UP 0x02
 #define PPC_ROUND_DOWN 0x03
 #define PPC_ROUND_MASK 0x03
+
+// IEEE binary16 conversion, truncating toward zero, independent of host FP mode.
+inline uint16_t PPCFloat32ToHalfBits(uint32_t bits) noexcept
+{
+    const uint16_t sign = uint16_t((bits >> 16) & 0x8000);
+    const uint32_t magnitude = bits & 0x7FFFFFFF;
+    const uint32_t exponent = magnitude >> 23;
+    const uint32_t fraction = magnitude & 0x7FFFFF;
+    if (exponent == 255)
+        return uint16_t(sign | 0x7C00 | (fraction ? 0x200 | (fraction >> 13) : 0));
+    if (magnitude >= 0x47800000)
+        return uint16_t(sign | 0x7BFF);
+    if (magnitude < 0x33800000)
+        return sign;
+    if (magnitude >= 0x38800000)
+        return uint16_t(sign | ((exponent - 112) << 10) | (fraction >> 13));
+    return uint16_t(sign | ((0x800000 | fraction) >> (126 - exponent)));
+}
+
+inline uint32_t PPCHalfBitsToFloat32(uint16_t bits) noexcept
+{
+    const uint32_t sign = uint32_t(bits & 0x8000) << 16;
+    const uint32_t exponent = (bits >> 10) & 31;
+    uint32_t fraction = bits & 1023;
+    if (exponent == 31)
+        return sign | 0x7F800000 | (fraction ? (fraction << 13) | 0x400000 : 0);
+    if (exponent != 0)
+        return sign | ((exponent + 112) << 23) | (fraction << 13);
+    if (fraction == 0)
+        return sign;
+    int power = -14;
+    while ((fraction & 0x400) == 0) { fraction <<= 1; --power; }
+    return sign | (uint32_t(power + 127) << 23) | ((fraction & 1023) << 13);
+}
 

+// Native guest state: SAT is sticky, NJ controls VMX denormal handling.
+struct PPCVSCRRegister
+{
+    uint32_t value = 0x10000;
+    uint32_t read() const noexcept { return value & 0x10001u; }
+    void write(uint32_t bits) noexcept { value = bits & 0x10001u; }
+    void markSaturation(bool saturated) noexcept { value |= uint32_t(saturated); }
+    bool nonJava() const noexcept { return (value & 0x10000u) != 0; }
+
+    int32_t signedFixed(uint32_t bits, uint32_t scale)
+    {
+        if (scale > 31)
+            throw std::out_of_range("VSCR_FIXED_SCALE_OUT_OF_RANGE");
+        const bool negative = (bits >> 31) != 0;
+        const uint32_t exponent = (bits >> 23) & 255;
+        const uint32_t fraction = bits & 0x7FFFFF;
+        // NaNs become zero without adding saturation; preserve existing SAT.
+        if (exponent == 255 && fraction != 0)
+            return 0;
+        if (exponent == 0)
+            return 0; // even scaled binary32 subnormals remain below one
+        const int power = int(exponent) - 127 + int(scale);
+        if (power < 0)
+            return 0;
+        if (power >= 31)
+        {
+            const bool exactMinimum = negative && power == 31 && fraction == 0;
+            markSaturation(!exactMinimum);
+            return negative ? INT32_MIN : INT32_MAX;
+        }
+        const uint64_t significand = 0x800000u | fraction;
+        const uint64_t magnitude = power <= 23 ? significand >> (23 - power) : significand << (power - 23);
+        return int32_t(negative ? -int64_t(magnitude) : int64_t(magnitude));
+    }
+};


+/** Creates an unlinked sparse mapping file in the process's writable temporary folder. */
+inline int CreatePrivateMappingFile(size_t length, bool read_only) {
+  static_assert(sizeof(off_t) == 8);
+  if (length == 0 || length > static_cast<size_t>(std::numeric_limits<off_t>::max())) {
+    errno = length == 0 ? EINVAL : EOVERFLOW;
+    return -1;
+  }
+  std::error_code error;
+  const auto folder = std::filesystem::temp_directory_path(error);
+  if (error) {
+    errno = error.value();
+    return -1;
+  }
+  std::string name = (folder / "rex-mapping-XXXXXX").string();
+  int fd = mkstemp(name.data());
+  if (fd < 0) return -1;
+  const auto fail = [&](int extra_fd = -1) {
+    const int saved_errno = errno;
+    if (extra_fd >= 0) close(extra_fd);
+    close(fd);
+    unlink(name.c_str());
+    errno = saved_errno;
+    return -1;
+  };
+  const int flags = fcntl(fd, F_GETFD);
+  if (flags < 0 || fcntl(fd, F_SETFD, flags | FD_CLOEXEC) < 0 ||
+      ftruncate(fd, static_cast<off_t>(length)) != 0) return fail();
+  int result = fd;
+  if (read_only) {
+    result = open(name.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (result < 0) return fail();
+  }
+  if (unlink(name.c_str()) != 0) return fail(result != fd ? result : -1);
+  if (result != fd) close(fd);
+  return result;
+}
 

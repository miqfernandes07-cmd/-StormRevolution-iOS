+// Native readback diagnostics use wall time, not hardware CPU/GPU utilization.
+// Inclusive draw time can contain resolve/memexport. Wait time is measured once
+// at the synchronous call sites. One line per >=5 seconds, no per-draw logging.
+enum class NativeReadbackKind : size_t { kDraw, kResolve, kMemexport, kCount };
+struct NativeReadbackWindow {
+  using Clock = std::chrono::steady_clock;
+  Clock::time_point start = Clock::now();
+  std::array<u64, 3> calls{}, nanoseconds{};
+  u64 bytes = 0, allocations = 0, wait_calls = 0, wait_nanoseconds = 0;
+  u32 depth = 0;
+};
+static NativeReadbackWindow& NativeReadbackCounters() {
+  static thread_local NativeReadbackWindow counters;
+  return counters;
+}
+class NativeReadbackScope {
+ public:
+  explicit NativeReadbackScope(NativeReadbackKind kind, u64 bytes = 0)
+      : counters_(NativeReadbackCounters()), kind_(static_cast<size_t>(kind)),
+        start_(NativeReadbackWindow::Clock::now()) {
+    ++counters_.depth;
+    counters_.bytes += bytes;
+  }
+  ~NativeReadbackScope() {
+    const auto now = NativeReadbackWindow::Clock::now();
+    ++counters_.calls[kind_];
+    counters_.nanoseconds[kind_] += std::chrono::duration_cast<std::chrono::nanoseconds>(now - start_).count();
+    const auto window_ms = std::chrono::duration_cast<std::chrono::milliseconds>(now - counters_.start).count();
+    if (--counters_.depth == 0 && window_ms >= 5000) {
+      REXGPU_INFO("Native GPU timing: window_ms={} draw_calls={} draw_inclusive_ms={} resolve_calls={} resolve_inclusive_ms={} memexport_calls={} memexport_inclusive_ms={} wait_calls={} wait_ms={} readback_allocations={} readback_bytes={}",
+                  window_ms, counters_.calls[0], counters_.nanoseconds[0] / 1000000,
+                  counters_.calls[1], counters_.nanoseconds[1] / 1000000,
+                  counters_.calls[2], counters_.nanoseconds[2] / 1000000,
+                  counters_.wait_calls, counters_.wait_nanoseconds / 1000000,
+                  counters_.allocations, counters_.bytes);
+      counters_ = NativeReadbackWindow{};
+    }
+  }
+  void Allocation() { ++counters_.allocations; }
+  template <typename F> bool Wait(F&& wait) {
+    const auto start = NativeReadbackWindow::Clock::now();
+    const bool result = wait();
+    ++counters_.wait_calls;
+    counters_.wait_nanoseconds += std::chrono::duration_cast<std::chrono::nanoseconds>(NativeReadbackWindow::Clock::now() - start).count();
+    return result;
+  }
+ private:
+  NativeReadbackWindow& counters_;
+  size_t kind_;
+  NativeReadbackWindow::Clock::time_point start_;
+};
+// End native readback diagnostics.
 

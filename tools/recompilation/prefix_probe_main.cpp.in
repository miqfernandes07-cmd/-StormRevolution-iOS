#include "cpu/xenon_checked_memory.h"
#include "memory/address_space.h"
#include "kernel/executable_module.h"
#include "kernel/virtual_memory.h"
#include "kernel/process_state.h"
#include "kernel/tls_state.h"
#include "kernel/imports.h"
#include "ppc_recomp_shared.h"
#include <cstdio>
#include <fstream>
#include <iterator>
#include <vector>
#include <string>
static unsigned entered=0;
// Explicit virtual profile only; no automatic host detection or renderer implied.
static unsigned diagnostic_av_pack=0;
PPC_FUNC(__imp__XGetAVPack){
    if(diagnostic_av_pack!=6)throw std::runtime_error("PROBE_VIDEO_PROFILE_NOT_BOUND");
    ctx.r3.u64=diagnostic_av_pack;
    std::puts("DIAGNOSTIC_AV_PACK virtual_vga=6 rendering_implemented=0");
}
static storm::kernel::ExecutableModule* module=nullptr;
static storm::kernel::VirtualMemory* vm=nullptr;
PPC_FUNC(__imp__XexCheckExecutablePrivilege){
    if(!module)throw std::runtime_error("PROBE_MODULE_NOT_BOUND");
    ctx.r3.u64=module->check_privilege(ctx.r3.u32)?1:0;
}
PPC_FUNC(__imp__RtlImageXexHeaderField){
    if(!module)throw std::runtime_error("PROBE_MODULE_NOT_BOUND");
    ctx.r3.u64=module->header_field(ctx.r3.u32,ctx.r4.u32);
    std::printf("KERNEL_HEADER_FIELD key=%08X result=%08X\n",ctx.r4.u32,ctx.r3.u32);
}
PPC_FUNC(__imp__NtAllocateVirtualMemory){
    if(!vm)throw std::runtime_error("PROBE_VM_NOT_BOUND");
    ctx.r3.u64=vm->allocate_guest(ctx.r3.u32,ctx.r4.u32,ctx.r5.u32,ctx.r6.u32,ctx.r7.u32);
    std::printf("KERNEL_VM_ALLOC status=%08X committed=%zu\n",ctx.r3.u32,vm->committed_bytes());
}
PPC_FUNC(__imp__NtFreeVirtualMemory){
    if(!vm)throw std::runtime_error("PROBE_VM_NOT_BOUND");
    ctx.r3.u64=vm->free_guest(ctx.r3.u32,ctx.r4.u32,ctx.r5.u32);
}
static storm::kernel::ProcessState* process_state=nullptr;
static storm::memory::AddressSpace* kernel_space=nullptr;
PPC_FUNC(__imp__KeQuerySystemTime){
    if(!kernel_space)throw std::runtime_error("PROBE_MEMORY_NOT_BOUND");
    kernel_space->store(ctx.r3.u32,8,storm::kernel::system_time_filetime());
}
PPC_FUNC(__imp__KeGetCurrentProcessType){
    if(!process_state)throw std::runtime_error("PROBE_PROCESS_NOT_BOUND");
    ctx.r3.u64=process_state->get_type();
    std::printf("KERNEL_PROCESS_TYPE %u\n",ctx.r3.u32);
}
PPC_FUNC(__imp__KeSetCurrentProcessType){
    if(!process_state)throw std::runtime_error("PROBE_PROCESS_NOT_BOUND");
    process_state->set_type(ctx.r3.u32);
}
PPC_FUNC(__imp__RtlInitializeCriticalSection){
    if(!kernel_space)throw std::runtime_error("PROBE_MEMORY_NOT_BOUND");
    storm::kernel::initialize_critical_section(*kernel_space,ctx.r3.u32);
}
PPC_FUNC(__imp__RtlInitializeCriticalSectionAndSpinCount){
    if(!kernel_space)throw std::runtime_error("PROBE_MEMORY_NOT_BOUND");
    ctx.r3.u64=storm::kernel::initialize_critical_section(*kernel_space,ctx.r3.u32,ctx.r4.u32);
}
static storm::kernel::CriticalSections* critical_sections=nullptr;
PPC_FUNC(__imp__RtlEnterCriticalSection){
    if(!critical_sections)throw std::runtime_error("PROBE_THREAD_NOT_BOUND");
    critical_sections->enter(ctx.r3.u32);
}
PPC_FUNC(__imp__RtlTryEnterCriticalSection){
    if(!critical_sections)throw std::runtime_error("PROBE_THREAD_NOT_BOUND");
    ctx.r3.u64=critical_sections->try_enter(ctx.r3.u32)?1:0;
}
PPC_FUNC(__imp__RtlLeaveCriticalSection){
    if(!critical_sections)throw std::runtime_error("PROBE_THREAD_NOT_BOUND");
    critical_sections->leave(ctx.r3.u32);
}
static storm::kernel::DynamicTls* dynamic_tls=nullptr;
static std::uint32_t diagnostic_thread=0;
PPC_FUNC(__imp__KeTlsAlloc){
    if(!dynamic_tls)throw std::runtime_error("PROBE_TLS_NOT_BOUND");
    ctx.r3.u64=dynamic_tls->allocate(diagnostic_thread);
    std::printf("KERNEL_TLS_ALLOC slot=%u\n",ctx.r3.u32);
}
PPC_FUNC(__imp__KeTlsFree){
    if(!dynamic_tls)throw std::runtime_error("PROBE_TLS_NOT_BOUND");
    ctx.r3.u64=dynamic_tls->free(ctx.r3.u32)?1:0;
}
PPC_FUNC(__imp__KeTlsGetValue){
    if(!dynamic_tls)throw std::runtime_error("PROBE_TLS_NOT_BOUND");
    ctx.r3.u64=dynamic_tls->get(diagnostic_thread,ctx.r3.u32);
}
PPC_FUNC(__imp__KeTlsSetValue){
    if(!dynamic_tls)throw std::runtime_error("PROBE_TLS_NOT_BOUND");
    dynamic_tls->set(diagnostic_thread,ctx.r3.u32,ctx.r4.u32);ctx.r3.u64=1;
}
@GUARDS@
@FUNCTIONS@
int main(int argc,char** argv){
    if(argc!=3)return 2;
    std::ifstream image_file(argv[1],std::ios::binary);
    std::vector<uint8_t> image(@IMAGE_SIZE@);
    if(!image_file.read(reinterpret_cast<char*>(image.data()),image.size())||image_file.peek()!=std::char_traits<char>::eof())return 3;
    storm::memory::AddressSpace space;
    space.map(@IMAGE_BASE@,image.size(),storm::memory::Access::read_write,image.data(),image.size());
    space.map(@STACK_BASE@,@STACK_SIZE@,storm::memory::Access::read_write);
    std::ifstream xex(argv[2],std::ios::binary);
    std::vector<uint8_t> header(@HEADER_SIZE@);
    if(!xex.read(reinterpret_cast<char*>(header.data()),header.size()))return 4;
    storm::kernel::XexHeader view(std::move(header));
    storm::kernel::ExecutableModule executable(space,view,{
        @MODULE_VARIABLE@,@MODULE_DESCRIPTOR@,@MODULE_HEADER@,@IMAGE_BASE@,uint32_t(image.size()),@ENTRY_ADDRESS@});
    module=&executable;executable.bind_handle_slot(@HANDLE_SLOT@,@HANDLE_WORD@);
    storm::kernel::VirtualMemory virtual_memory(space);vm=&virtual_memory;
    storm::kernel::ProcessState process(space,@PROCESS_BLOCK@);process_state=&process;kernel_space=&space;
    storm::kernel::HardwareInfo hardware(space,@HARDWARE_ADDRESS@,@HARDWARE_FLAGS@,@HARDWARE_CPUS@);
    hardware.bind_import(@HARDWARE_SLOT@,@HARDWARE_WORD@);
    storm::kernel::CriticalSections locks(space,@DIAGNOSTIC_THREAD@);critical_sections=&locks;
    storm::kernel::DynamicTls tls(space,@TLS_SLOTS@);
    diagnostic_thread=@DIAGNOSTIC_THREAD@;tls.attach(diagnostic_thread,@TLS_ADDRESS@);dynamic_tls=&tls;
    diagnostic_av_pack=@DIAGNOSTIC_AV_PACK@;
    storm::kernel::map_thread_identity(space,@PCR_ADDRESS@,@DIAGNOSTIC_THREAD@,@THREAD_NUMERIC_ID@);
    PPCContext ctx{};ctx.r13.u64=@PCR_ADDRESS@;ctx.r1.u64=@STACK_BASE@+@STACK_SIZE@-32;ctx.lr=0xdeadbee0;
    alignas(32)uint8_t placeholder[32]{};
    storm::cpu::AotFunctionTable table;
@REGISTRATIONS@
    table.seal();storm::cpu::AotBinding binding(table,ctx,placeholder,&space);
    try{
        storm::cpu::dispatch(ctx,placeholder,@ENTRY_ADDRESS@);
        std::puts("PROBE_UNEXPECTED_ENTRY_RETURN");return 5;
    }catch(const std::exception& error){
        std::printf("PREFIX_STOP entered=%u LR=%08X reason=%s\n",entered,unsigned(ctx.lr),error.what());return 0;
    }
}
